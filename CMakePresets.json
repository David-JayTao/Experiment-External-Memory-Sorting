{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows 原生 MSVC（自动发现已安装的 VS）",
      "description": "x64 多配置构建；Debug 用于断点调试，Release 用于计时。",
      "binaryDir": "${sourceDir}/build/windows",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 4 },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
